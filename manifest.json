{
  "manifest_version": 3,
  "name": "Convenient BOJ - 편한 백준",
  "short_name": "Convenient BOJ",
  "version": "1.5.0",
  "description": "백준 문제 화면에서 코드 작성·실행(C/C++/Java/Python)·제출·채점 결과 확인까지 한 번에.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Convenient BOJ",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "shared/workspace-worker.js"
  },
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://wandbox.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.acmicpc.net/problem/*",
        "https://acmicpc.net/problem/*"
      ],
      "js": [
        "vendor/themes/palettes.js",
        "shared/editor-settings.js",
        "shared/defaults.js",
        "shared/boj.js",
        "shared/stopwatch.js",
        "content/stopwatch.js",
        "content/compiler-diagnostics.js",
        "content/editor.js",
        "content/cases.js",
        "content/split.js"
      ],
      "css": [
        "content/split.css",
        "content/polish.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.acmicpc.net/submit/*",
        "https://acmicpc.net/submit/*"
      ],
      "js": [
        "vendor/boj/submit-selectors.js",
        "content/submit-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.acmicpc.net/submit/*",
        "https://acmicpc.net/submit/*"
      ],
      "js": [
        "shared/submit-selectors.js",
        "content/submit.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.acmicpc.net/status*",
        "https://acmicpc.net/status*"
      ],
      "js": [
        "shared/boj.js",
        "content/status.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["editor/frame.html"],
    "matches": ["https://www.acmicpc.net/*", "https://acmicpc.net/*"]
  }]
}
